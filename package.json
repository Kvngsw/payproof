{
  "name": "next-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx --env-file=.env.local scripts/e2e-smoke.ts",
    "check:webhook": "tsx --env-file=.env.local scripts/webhook-check.ts",
    "check:ratelimit": "tsx --env-file=.env.local scripts/ratelimit-check.ts",
    "check:assistant": "tsx --env-file=.env.local scripts/assistant-check.ts",
    "check:db": "tsx --env-file=.env.local scripts/db-check.ts",
    "rail:spike": "tsx --env-file=.env.local scripts/rail-spike.ts",
    "seed": "tsx lib/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/icons-react": "^3.48.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1"
  },
  "overrides": {
    "@emnapi/wasi-threads": "1.2.3"
  }
