# PayProof 2.0 — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://REPLACE_ME
DIRECT_URL=postgresql://REPLACE_ME
# Least-privilege runtime role (scripts/db-activate-role.ts). Falls back to
# DATABASE_URL when unset — production must set this.
APP_DATABASE_URL=postgresql://REPLACE_ME

# ── Auth ────────────────────────────────────────────────────────────────────
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Fraud (compat only — 2.0 uses the 50% rule in code) ─────────────────────
FRAUD_THRESHOLD=5

# ── Monnify ─────────────────────────────────────────────────────────────────
# Sandbox keys start with MK_TEST_. Dashboard → Settings → API Keys.
MONNIFY_API_KEY=MK_TEST_...
MONNIFY_SECRET_KEY=...
MONNIFY_CONTRACT_CODE=...
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Dashboard → Wallet. Source account for payouts.
MONNIFY_WALLET_ACCOUNT_NUMBER=...

# ── Rate limiting (blank = in-memory fallback, dev only) ────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
NODE_ENV=development

# ── Buyer OTP (SMTP + nodemailer) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
# Resend fallback when SMTP fails; dev returns the code in-band (demo safety).
RESEND_API_KEY=
OTP_FROM_EMAIL=noreply@payproof.ng
# dev = code returned in API response · live = SMTP → Resend → dev_screen chain
OTP_MODE=dev

# ── AI assistant (Gemini) ───────────────────────────────────────────────────
GEMINI_API_KEY=
# Model names are config: rotate without a deploy when Google retires one.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional override for docs/ai-prompt.md content (no deploy needed).
AI_SYSTEM_PROMPT=

# ── Logistics beneficiary (dispatch-fee transfer, D6) ───────────────────────
LOGISTICS_BANK_CODE=
LOGISTICS_ACCOUNT_NUMBER=
LOGISTICS_ACCOUNT_NAME=

# ── Demo fallback (cached verification + banner) ────────────────────────────
DEMO_FALLBACK=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
